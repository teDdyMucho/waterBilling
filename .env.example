# Kopyahin ito bilang .env.local at punan.
# BABALA: ANON KEY LANG. Huwag na huwag ilagay ang service_role key dito —
# napupunta ito sa browser bundle at makikita ng lahat.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

VITE_APP_NAME=Santa Cicilia Subdivision

# --- PWA Web Push (opsyonal) ---
# PUBLIC key lang dito (ligtas i-expose). Gawin ang keys:
#   npx web-push generate-vapid-keys
# Ang PRIVATE key ay sa Supabase Edge Function secrets lang (tingnan docs/PWA.md).
# Kapag walang value, naka-off lang ang notifications UI — gagana pa rin ang app.
VITE_VAPID_PUBLIC_KEY=
